{
  "name": "@kloyya/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./schema": "./src/schema.ts",
    "./scope": "./src/scope.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "dotenv -e ../../.env -- drizzle-kit migrate",
    "migrate:resilient": "dotenv -e ../../.env -- tsx scripts/apply-migrations.ts",
    "push": "dotenv -e ../../.env -- drizzle-kit push",
    "studio": "dotenv -e ../../.env -- drizzle-kit studio",
    "check": "drizzle-kit check",
    "verify:local": "tsx scripts/verify-migration.ts",
    "verify:remote": "dotenv -e ../../.env -- tsx scripts/verify-remote.ts",
    "audit:db": "dotenv -e ../../.env -- tsx scripts/audit-security.ts",
    "audit:storage": "dotenv -e ../../.env -- tsx scripts/audit-storage.ts",
    "audit:postgrest": "dotenv -e ../../.env -- tsx scripts/probe-postgrest.ts",
    "audit:bundle": "dotenv -e ../../.env -- tsx scripts/scan-client-bundle.ts",
    "audit": "pnpm audit:db && pnpm audit:storage && pnpm audit:postgrest",
    "harden:storage": "dotenv -e ../../.env -- tsx scripts/harden-storage.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.2",
    "dotenv-cli": "^8.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9"
  }
}
