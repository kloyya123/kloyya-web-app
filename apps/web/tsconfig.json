{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,

    // Strictness. Every flag below is deliberate; see notes.
    "strict": true,
    // `arr[i]` yields `T | undefined`. Catches the single most common bug class
    // that mock data hides and a real backend surfaces.
    "noUncheckedIndexedAccess": true,
    // Distinguishes "key absent" from "key present, value undefined".
    // Matters because the API envelope has genuinely optional fields
    // (pagination.totalCount is "when practical" per KAS).
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "forceConsistentCasingInFileNames": true,

    "plugins": [{ "name": "next" }],

    // One alias per architectural layer (KFA). An import line should reveal
    // which layer it crosses, so layering violations are visible in review.
    "paths": {
      "@server/*": ["./server/*"],
      "@/app/*": ["./app/*"],
      "@/components/*": ["./components/*"],
      "@/features/*": ["./features/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/lib/*": ["./lib/*"],
      "@/mock/*": ["./mock/*"],
      "@/providers/*": ["./providers/*"],
      "@/services/*": ["./services/*"],
      "@/styles/*": ["./styles/*"],
      "@/types/*": ["./types/*"],
      "@/utils/*": ["./utils/*"],
      "@/test/*": ["./test/*"],
      "@/*": ["./*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    "**/*.mts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
