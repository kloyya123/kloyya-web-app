# =============================================================================
# Kloyya — environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`. On Windows/PowerShell, write
# this file as UTF-8 WITHOUT a BOM — a BOM silently corrupts the first variable.
#
# Kloyya is ONE Next.js app (apps/web) deployed on Vercel + Supabase. Next does
# not auto-read this root file; for LOCAL real-backend dev, put these in
# apps/web/.env.local. Mock mode (NEXT_PUBLIC_USE_REAL_API unset) needs none.
# =============================================================================

# --- Core ------------------------------------------------------------------
NODE_ENV=development
# Flip the web app from built-in mock data to the real backend.
NEXT_PUBLIC_USE_REAL_API=true
# Where this app is reachable — OAuth redirects and invitation links point here.
APP_URL="http://localhost:3000"

# --- Supabase (Auth + Postgres + Storage) ----------------------------------
# Public (browser-safe): Project Settings → API. The publishable/anon key.
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."
# SECRET, server-only: the service_role key. Full power, bypasses RLS —
# never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=""
# Postgres connection strings (Project Settings → Database). DATABASE_URL is the
# transaction pooler (6543) for the app; DIRECT_URL is the direct 5432, required
# by drizzle-kit for migrations. SAME project as the keys above.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# The private Storage bucket uploaded documents land in.
DOCUMENTS_BUCKET="documents"

# --- Email (Resend) --------------------------------------------------------
# Account verification email is Supabase's own (dashboard-configured SMTP). This
# key powers the app's OWN mail — invitations. resend.com → API Keys.
RESEND_API_KEY=""
EMAIL_FROM="Kloyya <noreply@kloyya.com>"

# --- Encryption ------------------------------------------------------------
# Encrypts customers' connector OAuth tokens at rest. Must decode to exactly 32
# bytes; use base64url (a '/' in plain base64 can be rewritten by some shells).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=""

# --- AI (Ask Kloyya, summaries, drafting) ----------------------------------
# Provider-neutral. AI_PROVIDER names the preferred one, but resolveAiProvider()
# automatically falls back through every other configured provider at call
# time (server/ai/provider.ts) — so this is a preference, not a hard
# requirement. All keys are server-only; absent → that provider is simply
# skipped in the fallback chain, never an error.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
NVIDIA_API_KEY=""
NVIDIA_MODEL="openai/gpt-oss-120b"
HUGGINGFACE_API_KEY=""
HUGGINGFACE_MODEL="deepseek-ai/DeepSeek-V4-Flash:novita"

# --- OAuth connectors (optional) -------------------------------------------
# Redirect URIs must match BOTH the callback route and the provider console.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/integrations/oauth/google/callback"
NOTION_OAUTH_CLIENT_ID=""
NOTION_OAUTH_CLIENT_SECRET=""
NOTION_OAUTH_REDIRECT_URI="http://localhost:3000/api/v1/integrations/oauth/notion/callback"

# --- Analytics (PostHog, optional) -----------------------------------------
# NEXT_PUBLIC_POSTHOG_KEY is the PROJECT key (phc_), browser-safe.
# POSTHOG_PERSONAL_API_KEY is a PERSONAL key (phx_), a SECRET — server-only.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_PERSONAL_API_KEY=""

# --- Error tracking (Sentry, optional) --------------------------------------
# sentry.io -> Settings -> Projects -> (your project) -> Client Keys (DSN).
# Not a secret — it only lets a client SEND events, never read them.
NEXT_PUBLIC_SENTRY_DSN=""
# The three below are only needed to upload source maps at build time, so
# stack traces in Sentry show real file/line numbers instead of minified
# code. All optional: without them the build just skips that upload.
# sentry.io -> Settings -> Auth Tokens (needs project:releases scope).
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
