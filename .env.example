# =============================================================================
# Kloyya backend — environment template
# =============================================================================
# Copy to `.env` and fill in. NEVER commit `.env`. On Windows/PowerShell, write
# this file as UTF-8 WITHOUT a BOM — a BOM silently corrupts the first variable.
# (VS Code: "Save with Encoding" → "UTF-8", not "UTF-8 with BOM".)
# =============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# --- Database (Supabase Postgres) ------------------------------------------
# From Supabase dashboard → Project Settings → Database → Connection string.
# DATABASE_URL uses the pooled (pgbouncer) connection for the app;
# DIRECT_URL uses the direct 5432 (session pooler) connection, required by
# drizzle-kit for migrations (the transaction pooler can't run migrations).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth (Better Auth — self-hosted, not Supabase Auth) -------------------
# BETTER_AUTH_SECRET signs sessions/tokens; must be stable across restarts —
# changing it invalidates every live session.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_SECRET=""
# The API's own base URL, used to build verification/callback links.
BETTER_AUTH_URL="http://localhost:4000"

# --- Email (Resend) --------------------------------------------------------
# resend.com → API Keys. Verification codes and password resets go through this.
# Without it, dev logs the codes instead of sending; production refuses to boot.
RESEND_API_KEY=""
# Must be on a domain verified in Resend. The shared resend.dev sandbox only
# delivers to the Resend account owner, so it is not usable for real users.
EMAIL_FROM="Kloyya <noreply@kloyya.com>"

# --- Supabase (Storage; Phase 10) ------------------------------------------
# From Supabase dashboard → Project Settings → API. Auth is Better Auth, and
# RLS is app-driven (a session GUC), so no Supabase Auth keys are needed here.
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""  # SECRET, server-only; for Storage admin operations

# --- Redis --- NOT USED IN BETA -------------------------------------------
# Deliberately empty. The beta stack is $0/month and the "what to avoid in Month 1"
# list rules out Redis and Upstash: the goal is validating the product, not
# building hyperscale infrastructure. Postgres is the only datastore.
REDIS_URL=""

# --- Encryption ------------------------------------------------------------
# Encrypts customers' third-party OAuth tokens at rest (Phase 8). Must decode to
# exactly 32 bytes; the API validates this at boot and refuses to start otherwise.
# Use base64url — a plain-base64 key can contain '/', which some shells rewrite
# into a file path, corrupting the key silently.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
TOKEN_ENCRYPTION_KEY=""

# --- OAuth (Phase 8 — not needed until connectors) -------------------------
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI="http://localhost:4000/v1/integrations/google/callback"

# --- AI (powers Ask Kloyya, summaries, drafting) ---------------------------
# The AI layer is provider-neutral. AI_PROVIDER selects the default:
#   openai    → uses OPENAI_API_KEY (platform.openai.com → API Keys)
#   anthropic → uses ANTHROPIC_API_KEY (console.anthropic.com → API Keys)
# Both keys are server-only and never exposed to the browser. If the selected
# provider has no key, AI features degrade to an honest "not configured" state.
AI_PROVIDER="openai"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# --- Analytics (PostHog) ---------------------------------------------------
# Two different keys, do not confuse them:
#   • NEXT_PUBLIC_POSTHOG_KEY — the PROJECT key (starts with `phc_`), safe to ship
#     to the browser; this is what posthog-js uses. Get it from PostHog →
#     Project Settings → Project API Key.
#   • POSTHOG_PERSONAL_API_KEY — a PERSONAL key (starts with `phx_`), a SECRET with
#     broad account access; server-only, used for the management API. NEVER put a
#     phx_ key in a NEXT_PUBLIC_* var or it ships to every visitor.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
POSTHOG_PERSONAL_API_KEY=""  # SECRET, server-only

# --- Frontend ↔ API --------------------------------------------------------
# The web app calls the API through this base URL.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000/v1"
# CORS: which origins the API accepts. Comma-separated.
CORS_ALLOWED_ORIGINS="http://localhost:3000"
