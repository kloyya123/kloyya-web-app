# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
.next/
out/
.turbo/
*.tsbuildinfo

# Test / coverage
coverage/

# Environment — never commit real secrets. .env.example is the documented template.
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
Thumbs.db
*.log

# Reference material that lives beside the code but isn't part of the build.
# (No quotes — gitignore treats spaces literally and quotes as characters.)
About Kloyya Info PRD AND ALL files to check/
Master Build Prompt/
KloyyaBACKEND/
LOGO/
SKILL/
claude-session.txt/
*.docx
*.pdf

# Agent tooling (regenerable via `npx skills add`)
.agents/
skills-lock.json

# Vercel CLI: link metadata, and the .env.local it writes when you `vercel link`
# or `vercel env pull` — that file holds real production secrets.
.vercel

# Every env file EXCEPT the committed template. Written as an allowlist so a
# new .env.<something> is ignored by default rather than by remembering to add
# it; .env.example is the one file that must stay tracked.
.env
.env.*
!.env.example
